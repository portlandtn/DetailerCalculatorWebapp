[Unit]
Description=Detailer Calculator production service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jedmay
Group=jedmay
WorkingDirectory=/opt/calc/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=18882
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
